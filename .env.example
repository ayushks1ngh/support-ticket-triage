# Provider: groq or nvidia
MODEL_PROVIDER=groq
# Verify model availability for your provider account.
MODEL_ID=llama-3.3-70b-versatile

# Set exactly the key for the selected provider. Never commit .env.
GROQ_API_KEY=
NVIDIA_API_KEY=

# Optional endpoint override (normally leave blank)
MODEL_BASE_URL=

# Triage policy
HUMAN_REVIEW_THRESHOLD=0.75
BATCH_SIZE=10
MAX_CONCURRENCY=1
MAX_RETRY_ATTEMPTS=3
RETRY_INITIAL_DELAY_SECONDS=1
RETRY_MAX_DELAY_SECONDS=8
MODEL_MAX_TOKENS=4096
MODEL_TEMPERATURE=0.01
